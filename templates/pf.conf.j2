# **************************************************************************************
#
# {{ ansible_managed }}
#
# **************************************************************************************

# default macros
my_network="{ {{ firewall_pf_mynetwork }} }"
my_hostip="{ {{ firewall_pf_myhostip }} }"
tcp_in="{ ssh, domain{{ firewall_pf_tcp_svcs_in }} }"
udp_in="{ ssh, domain{{ firewall_pf_udp_svcs_in }} }"
tcp_out="{ ssh, domain, http, https{{ firewall_pf_tcp_svcs_out }} }"
udp_out="{ ssh, domain{{ firewall_pf_udp_svcs_out }} }"
icmp_types="{ echoreq }"

# custom macros
{%- for item in firewall_pf_macros %}

{{ item['macro'] }}
{%- endfor %}


# filter rules
set skip on lo
scrub in all
block in log all

# ingress rules
pass in log on {{ firewall_pf_int_groupname }} proto tcp from $my_network to $my_hostip port $tcp_in keep state
pass in log on {{ firewall_pf_int_groupname }} proto udp from $my_network to $my_hostip port $udp_in keep state

# custom ingress rules
{%- for item in firewall_pf_ingress_rules %}

{{ item['rule'] }}

{%- endfor %}


# egress rules

pass out log on {{ firewall_pf_int_groupname }} proto tcp to port $tcp_out 
pass out log on {{ firewall_pf_int_groupname }} proto udp to port $udp_out
pass inet proto icmp icmp-type $icmp_types

# custom egress rules

{%- for item in firewall_pf_egress_rules %}

{{ item['rule'] }}
{%- endfor %}
